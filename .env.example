# HIMUNI — Audius Read-Only Discovery Configuration
# Public read-only endpoints work out of the box using VITE_AUDIUS_APP_NAME=himuni.
# Optional: provide a public Audius API key (never place a private secret or Bearer token here).

VITE_AUDIUS_APP_NAME=himuni
VITE_AUDIUS_API_BASE=https://api.audius.co/v1
VITE_AUDIUS_API_KEY=
